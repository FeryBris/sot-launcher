<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
  <div class="shell">
    <%- include('partials/nav', { active: 'dashboard' }) %>
    <main class="main">
      <h1>Dashboard</h1>
      <div class="stat-grid">
        <div class="stat"><div class="n"><%= counts.addons %></div><div class="l">Addons</div></div>
        <div class="stat"><div class="n"><%= counts.wtf %></div><div class="l">WTF Files</div></div>
        <div class="stat"><div class="n"><%= counts.news %></div><div class="l">News Posts</div></div>
        <div class="stat"><div class="n"><%= counts.releases %></div><div class="l">Launcher Releases</div></div>
      </div>
      <p class="hint">
        Publish addons, WTF files and news here — the desktop launcher reads them from
        <code>/api/manifest</code>. Publish launcher installers under Launcher Releases to
        power in-app self-update via <code>/api/launcher/latest.json</code>.
      </p>
    </main>
  </div>
</body>
</html>
