<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div class="shell">
    <%- include('../partials/nav', { active: 'wtf' }) %>
    <main class="main">
      <div class="page-header">
        <h1>WTF Files</h1>
        <a class="btn" href="/admin/wtf/new">+ New File</a>
      </div>

      <% if (files.length === 0) { %>
        <div class="empty">No WTF/SavedVariables files published yet.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Name</th><th>Version</th><th>Target Path</th><th></th></tr>
          </thead>
          <tbody>
            <% files.forEach(f => { %>
              <tr>
                <td><%= f.name %></td>
                <td><%= f.version %></td>
                <td><code><%= f.target_path %></code></td>
                <td class="actions">
                  <a class="btn secondary" href="/admin/wtf/<%= f.id %>/edit">Edit</a>
                  <form method="post" action="/admin/wtf/<%= f.id %>?_method=DELETE" onsubmit="return confirm('Delete <%= f.name %>?')">
                    <button class="btn danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </main>
  </div>
</body>
</html>
