<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div class="shell">
    <%- include('../partials/nav', { active: 'wtf' }) %>
    <main class="main">
      <h1><%= item ? 'Edit WTF File' : 'New WTF File' %></h1>

      <form
        class="card"
        method="post"
        enctype="multipart/form-data"
        action="<%= item ? `/admin/wtf/${item.id}?_method=PUT` : '/admin/wtf' %>"
      >
        <div>
          <label>Name</label>
          <input type="text" name="name" required value="<%= item ? item.name : '' %>" placeholder="Raid HealBot Profile" />
        </div>
        <div>
          <label>Version</label>
          <input type="text" name="version" required value="<%= item ? item.version : '' %>" placeholder="2024-07-21" />
        </div>
        <div>
          <label>Target Path (relative to WoW folder)</label>
          <input
            type="text"
            name="target_path"
            required
            value="<%= item ? item.target_path : '' %>"
            placeholder="WTF/Account/ACCOUNTNAME/SavedVariables/HealBot.lua"
          />
          <p class="hint">Written exactly at this path under the player's WoW install folder.</p>
        </div>
        <div>
          <label>File <%= item ? '(leave empty to keep current file)' : '' %></label>
          <input type="file" name="file" <%= item ? '' : 'required' %> />
          <% if (item) { %><p class="hint">Current file hash: <%= item.sha256.slice(0, 16) %>...</p><% } %>
        </div>
        <button class="btn" type="submit"><%= item ? 'Save Changes' : 'Publish File' %></button>
      </form>
    </main>
  </div>
</body>
</html>
