<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div class="shell">
    <%- include('../partials/nav', { active: 'releases' }) %>
    <main class="main">
      <div class="page-header">
        <h1>Launcher Releases</h1>
        <a class="btn" href="/admin/releases/new">+ New Release</a>
      </div>

      <p class="hint">
        The launcher checks <code>/api/launcher/latest.json</code> and always self-updates to the most
        recently created release below, so add releases in order.
      </p>

      <% if (releases.length === 0) { %>
        <div class="empty">No launcher releases published yet.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Version</th><th>Published</th><th>Platforms</th><th></th></tr>
          </thead>
          <tbody>
            <% releases.forEach(r => { %>
              <tr>
                <td><%= r.version %></td>
                <td><%= r.pub_date %></td>
                <td>
                  <% platformsByRelease[r.id].forEach(p => { %>
                    <span class="badge mandatory"><%= p.platform %></span>
                  <% }) %>
                  <% if (platformsByRelease[r.id].length === 0) { %><span class="badge">none yet</span><% } %>
                </td>
                <td class="actions">
                  <a class="btn secondary" href="/admin/releases/<%= r.id %>">Manage</a>
                  <form method="post" action="/admin/releases/<%= r.id %>?_method=DELETE" onsubmit="return confirm('Delete release <%= r.version %>?')">
                    <button class="btn danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </main>
  </div>
</body>
</html>
