<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
  <div class="shell">
    <%- include('../partials/nav', { active: 'addons' }) %>
    <main class="main">
      <div class="page-header">
        <h1>Addons</h1>
        <a class="btn" href="/admin/addons/new">+ New Addon</a>
      </div>

      <% if (addons.length === 0) { %>
        <div class="empty">No addons published yet.</div>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Name</th><th>Version</th><th>Category</th><th>Updated</th><th></th></tr>
          </thead>
          <tbody>
            <% addons.forEach(a => { %>
              <tr>
                <td><%= a.name %></td>
                <td><%= a.version %></td>
                <td><span class="badge <%= a.category %>"><%= a.category %></span></td>
                <td><%= a.updated_at %></td>
                <td class="actions">
                  <a class="btn secondary" href="/admin/addons/<%= a.id %>/edit">Edit</a>
                  <form method="post" action="/admin/addons/<%= a.id %>?_method=DELETE" onsubmit="return confirm('Delete <%= a.name %>?')">
                    <button class="btn danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </main>
  </div>
</body>
</html>
