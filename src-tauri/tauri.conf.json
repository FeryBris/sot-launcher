{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SoTLauncher",
  "mainBinaryName": "sotlauncher",
  "version": "0.1.26",
  "identifier": "gg.sotlauncher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SoT Launcher",
        "width": 980,
        "height": 640,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost https://sot.sk https://cdn.discordapp.com data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://sot.sk/api/launcher/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3M0JENTA2NThGMzFBMEMKUldRTUd2TllCdFU3Ti9oaFh5VkRXaUdBRFBkWkVleUpOQU1kQ0p0eWprOGk0YXBlUURPQkpzSEYK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["sot-launcher"]
      }
    }
  }
}
