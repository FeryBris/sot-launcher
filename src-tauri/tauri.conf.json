{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SoTGuildLauncher",
  "version": "0.1.0",
  "identifier": "gg.sotguild.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SoT Guild Launcher",
        "width": 980,
        "height": 640,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://sot.sk/api/launcher/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3M0JENTA2NThGMzFBMEMKUldRTUd2TllCdFU3Ti9oaFh5VkRXaUdBRFBkWkVleUpOQU1kQ0p0eWprOGk0YXBlUURPQkpzSEYK"
    }
  }
}
