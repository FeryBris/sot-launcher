# Copy this file to .env (gitignored) and fill in the real values before
# building. Baked into the binary at compile time by build.rs — never
# shown in the app UI, never stored in the user's settings.json.
SOT_API_KEY=
SOT_API_BASE_URL=https://sot.sk/api/launcher
# Forever's guild site, with its own launcher API key and Discord sign-in.
# Optional: left empty, Forever uses the site above.
SOT_API_KEY_FOREVER=
SOT_API_BASE_URL_FOREVER=https://forever.sot.sk/api/launcher
